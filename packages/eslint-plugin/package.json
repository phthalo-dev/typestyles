{
  "name": "@typestyles/eslint-plugin",
  "version": "0.5.0",
  "description": "ESLint rules for TypeStyles style objects and namespace usage",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "typestyles",
    "css-in-ts"
  ],
  "dependencies": {
    "@typescript-eslint/utils": "^8.54.0",
    "@typestyles/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript-eslint/rule-tester": "^8.54.0",
    "eslint": "^10.13.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/phthalo-dev/typestyles",
    "directory": "packages/eslint-plugin"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0"
  }
}
