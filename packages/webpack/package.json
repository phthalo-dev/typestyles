{
  "name": "@typestyles/webpack",
  "version": "0.5.6",
  "description": "webpack plugin for typestyles build extraction",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "webpack",
    "typestyles",
    "plugin",
    "css-in-js"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/phthalo-dev/typestyles",
    "directory": "packages/webpack"
  },
  "peerDependencies": {
    "webpack": ">=5.0.0"
  },
  "dependencies": {
    "@typestyles/build-runner": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "typescript": "catalog:",
    "webpack": "^5.98.0",
    "vite-plus": "catalog:"
  }
}
