{
  "name": "@typestyles/build-runner",
  "version": "0.6.4",
  "description": "Shared module execution utilities for typestyles build integrations",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "^0.27.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "typescript": "catalog:",
    "typestyles": "workspace:*",
    "vite-plus": "catalog:"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/phthalo-dev/typestyles",
    "directory": "packages/build-runner"
  }
}
