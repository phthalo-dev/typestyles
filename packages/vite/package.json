{
  "name": "@typestyles/vite",
  "version": "0.5.2",
  "description": "Vite plugin for typestyles HMR support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "typestyles",
    "hmr",
    "css-in-js"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/phthalo-dev/typestyles",
    "directory": "packages/vite"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "typestyles": "workspace:*",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "@typestyles/build-runner": "workspace:*"
  }
}
