{
  "name": "@typestyles/rollup",
  "version": "0.5.7",
  "description": "Rollup and Rolldown plugin for typestyles",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rollup",
    "rolldown",
    "typestyles",
    "plugin",
    "css-in-js"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/phthalo-dev/typestyles",
    "directory": "packages/rollup"
  },
  "peerDependencies": {
    "rollup": ">=4.0.0"
  },
  "dependencies": {
    "@typestyles/build-runner": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "rollup": "^4.0.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
