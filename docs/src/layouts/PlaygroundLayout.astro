---
/**
 * Playground shell on the kit chrome: the same `DocsTopBar` (search + `DocsAppearanceMenu`) and
 * `DocsMobileMenu` as every docs page, in an `AppShell` whose content fills the viewport (no
 * sidebar, TOC or page padding: the editor and preview own the space). Built like Var UI's own
 * playground layout (`DocsPage`/`DocsMarketingPage` would add a scrolling, padded main column).
 *
 * Colour mode comes from the kit's `ThemeScript` (`theme-mode` key, `data-color-mode` on
 * `<html>`), shared with the docs pages. Playground internals are unchanged.
 */
import { ClientRouter } from 'astro:transitions';
import { AppShell, Layout, LayoutContent, ThemeScript } from '@var-ui/astro';
import { defaultThemeClassName } from '@var-ui/core';
import DocsFavicon from '@var-ui/docs/DocsFavicon';
import DocsMobileMenu from '@var-ui/docs/DocsMobileMenu';
import DocsTopBar from '@var-ui/docs/DocsTopBar';
import { normalizeDocsPath } from '@var-ui/docs/utils';
import KitSiteHead from '../components/KitSiteHead.astro';
import { toKitTopNav } from '../lib/kitNav';
import { getKitSearchItems } from '../lib/kitSearchItems';
import { playground } from '../styles/playground';

type Props = {
  title?: string;
};

const { title = 'Playground — typestyles' } = Astro.props;

const topNav = toKitTopNav();
const searchItems = await getKitSearchItems();
const brand = { heading: 'typestyles', href: '/' };
const currentPath = normalizeDocsPath(Astro.url.pathname);
---

<html lang="en" class={defaultThemeClassName}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <DocsFavicon />
    <ThemeScript themeClass={defaultThemeClassName} />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}typestyles.css`} />
    <ClientRouter />
    <KitSiteHead />
    <!-- Monaco and the preview placeholder use JetBrains Mono (`monacoSetup.ts`, `playgroundClient.ts`). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400..600;1,400..600&display=swap"
    />
    <!-- Static copy from build-playground-assets (monaco package exports block CSS imports). -->
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}playground/monaco-editor.css`} />
  </head>
  <body class="docs-body">
    <AppShell variant="wash" height="fill" contentPadding="none" mobileBreakpoint="md">
      <DocsTopBar
        slot="topNav"
        topNav={topNav}
        searchItems={searchItems}
        brand={brand}
        currentPath={currentPath}
      >
        {/* Without a `brand` slot the kit renders an empty brand link (kit gap, see issues file). */}
        <span slot="brand">typestyles</span>
      </DocsTopBar>
      <DocsMobileMenu slot="mobileNav" topNav={topNav} currentPath={currentPath} brand={brand}>
        <span slot="brand">typestyles</span>
      </DocsMobileMenu>
      <Layout height="fill" padding="none" className={playground.layout}>
        <LayoutContent label="Playground" className={playground.content}>
          <div class={playground.page} data-playground>
            <slot />
          </div>
        </LayoutContent>
      </Layout>
    </AppShell>
  </body>
</html>
