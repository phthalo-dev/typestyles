---
/**
 * Site shell from `@var-ui/docs` (`DocsPage`: top bar, sidebar, TOC, mobile menu, search,
 * appearance menu). Page bodies are still rendered by each page (prose from `getDocBySlug`).
 */
import DocsPage from '@var-ui/docs/DocsPage';
import { defaultThemeClassName } from '@var-ui/core';
import { codeHljsScope, defaultTheme as legacyTheme } from '@examples/design-system';
import CodeBlockCopy from '../components/CodeBlockCopy.astro';
import type { DocHeading } from '../lib/docs';
import { toKitSidebarSections, toKitTopNav } from '../lib/kitNav';
import { getKitSearchItems } from '../lib/kitSearchItems';
import { docNavigation } from '../navigation';

type Props = {
  title: string;
  currentPath: string;
  /** Headings of the page; the TOC rail shows when there is at least one. */
  toc?: DocHeading[];
  /** Full-width content column (landing pages). */
  wide?: boolean;
  /** Hide the docs sidebar (home page). */
  sidebar?: boolean;
  canonicalUrl?: string;
  /** Sibling `.md` URL for `<link rel="alternate">`. */
  markdownAlternateUrl?: string;
};

const {
  title,
  currentPath,
  toc = [],
  wide = false,
  sidebar = true,
  canonicalUrl,
  markdownAlternateUrl,
} = Astro.props;

const topNav = toKitTopNav();
const sidebarSections = sidebar ? toKitSidebarSections(docNavigation) : null;
const searchItems = await getKitSearchItems();
/**
 * Components not yet moved to the kit (LiveDemo, PageFooter, Pagination, Alert, prose…) read
 * `@examples/design-system` tokens, which only resolve under its theme class on `<html>`.
 * `DocsPage` takes a single `themeClassName` (it is passed to `classList.add`), so the legacy
 * class is added by the inline script below. Remove with the legacy components.
 */
const legacyThemeClassName = legacyTheme.className;
---

<DocsPage
  title={title}
  themeClassName={defaultThemeClassName}
  bodyClassName={codeHljsScope.root}
  topNav={topNav}
  sidebarSections={sidebarSections}
  searchItems={searchItems}
  brand={{ heading: 'typestyles', href: '/' }}
  contentWidth={wide ? 'full' : 'default'}
  showToc={toc.length > 0}
  tocContentSelector="[data-doc-article]"
>
  {/* Without a `brand` slot the kit renders an empty brand link (kit gap, see issues file). */}
  <span slot="brand">typestyles</span>
  <Fragment slot="head">
    <script is:inline define:vars={{ legacyThemeClassName }}>
      document.documentElement.classList.add(legacyThemeClassName);
      if (!window.__typestylesLegacyThemeNav) {
        window.__typestylesLegacyThemeNav = true;
        document.addEventListener('astro:before-swap', (event) => {
          event.newDocument.documentElement.classList.add(legacyThemeClassName);
        });
      }
    </script>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {markdownAlternateUrl && <link rel="alternate" type="text/markdown" href={markdownAlternateUrl} />}
    <link rel="llms-txt" href="/llms.txt" type="text/plain" title="Documentation index for LLMs" />
    <link
      rel="service-desc"
      href="/.well-known/mcp.json"
      type="application/json"
      title="MCP server discovery"
    />
    <link rel="service" href="/mcp" title="MCP server" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=JetBrains+Mono:ital,wght@0,400..600;1,400..600&display=swap"
    />
  </Fragment>
  <div data-doc-article>
    <slot />
  </div>
  <CodeBlockCopy />
</DocsPage>

<script>
  import { attachDocInstallTabs } from '../scripts/docInstallTabs';
  attachDocInstallTabs();
</script>
