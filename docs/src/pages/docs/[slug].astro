---
// @ts-nocheck
import KitDocsLayout from '../../layouts/KitDocsLayout.astro';
import PageFooter from '../../components/PageFooter.astro';
import Pagination from '../../components/Pagination.astro';
import { doc, docProseRoot } from '../../styles';
import LiveDemo from '../../components/LiveDemo.astro';
import DocAiActions from '../../components/DocAiActions.astro';
import { extractDocHeadings, getAllDocs, getDocBySlug, getDocNeighbors } from '../../lib/docs';
import { splitDocContentParts } from '../../lib/expandLiveDemos';
import { findDoc } from '../../navigation';
import { editUrlForDocSlug } from '../../lib/site';
import { docHtmlUrl, docMarkdownUrl } from '../../lib/siteUrl';

export async function getStaticPaths() {
  const docs = await getAllDocs();
  return docs.map((entry) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/docs');
}

const entry = await getDocBySlug(slug);

if (!entry) {
  throw new Error(`Document not found for slug: ${slug}`);
}

const neighbors = getDocNeighbors(slug);
const tocHeadings = extractDocHeadings(entry.html);
const editHref = editUrlForDocSlug(slug);
const navEntry = findDoc(slug);
/** Surface the parent nav category as a kicker above H1 (falls back to "Documentation"). */
const kicker = navEntry?.category?.title ?? 'Documentation';
const contentParts = splitDocContentParts(entry.html);
const canonicalUrl = docHtmlUrl(slug);
const markdownUrl = docMarkdownUrl(slug);
---

<KitDocsLayout
  currentPath={`/docs/${slug}`}
  title={`${entry.title} - typestyles documentation`}
  toc={tocHeadings}
  canonicalUrl={canonicalUrl}
  markdownAlternateUrl={markdownUrl}
>
  <article class={doc.root}>
    <p class={doc.kicker} aria-hidden="true">
      <span class={doc.kickerDot}></span>
      {kicker}
    </p>
    <h1 class={doc.title}>{entry.title}</h1>
    <DocAiActions markdownUrl={markdownUrl} />
    {entry.description && <p class={doc.description}>{entry.description}</p>}
    {
      contentParts.map((part) =>
        part.type === 'html' ? (
          <div class:list={[docProseRoot, doc.content]} set:html={part.html} />
        ) : (
          <LiveDemo id={part.id} />
        ),
      )
    }

    {
      slug === 'component-library' ? (
        <div class:list={[docProseRoot, doc.content]}>
          <h2>See also</h2>
          <p>
            The components this site is built from (Var UI buttons, alerts, tabs, code blocks and
            more) are shown together on the{' '}
            <a href="/docs/design-system/kitchen-sink">docs kitchen sink</a>.
          </p>
        </div>
      ) : null
    }

    <PageFooter lastModified={entry.lastModified} editHref={editHref} />
    <Pagination prev={neighbors.prev} next={neighbors.next} />
  </article>
</KitDocsLayout>
