---
import { ClientRouter } from 'astro:transitions';
import type { AppearanceBootstrap } from '../lib/docsAppearanceRuntime';

type Props = {
  title: string;
  /** Used by the blocking boot script to prevent appearance flash. */
  appearanceBootstrap: AppearanceBootstrap;
  /** Pre-extracted Typestyles stylesheet (`@typestyles/vite` serves it in dev and emits it on build). */
  typestylesCssHref?: string;
  /** Canonical page URL for SEO and AI alternates. */
  canonicalUrl?: string;
  /** Sibling `.md` URL for `<link rel="alternate">`. */
  markdownAlternateUrl?: string;
};

const { title, appearanceBootstrap, typestylesCssHref, canonicalUrl, markdownAlternateUrl } =
  Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{markdownAlternateUrl && (
  <link rel="alternate" type="text/markdown" href={markdownAlternateUrl} />
)}
<link rel="llms-txt" href="/llms.txt" type="text/plain" title="Documentation index for LLMs" />
<link
  rel="service-desc"
  href="/.well-known/mcp.json"
  type="application/json"
  title="MCP server discovery"
/>
<link rel="service" href="/mcp" title="MCP server" />
<title>{title}</title>
<ClientRouter />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=JetBrains+Mono:ital,wght@0,400..600;1,400..600&display=swap"
/>
{typestylesCssHref && <link rel="stylesheet" href={typestylesCssHref} />}
<script type="application/json" id="appearance-bootstrap" set:html={JSON.stringify(appearanceBootstrap)} />
<script is:inline>
  (function () {
    function applyDocsAppearanceFromStorage(rootEl, bootstrapDoc) {
      try {
        var el = bootstrapDoc.getElementById('appearance-bootstrap');
        if (!el || !el.textContent || !el.textContent.trim()) return;

        var P = JSON.parse(el.textContent);
        /* Keep in sync with `readStoredStyle`/`readStoredMode` in ../lib/docsAppearanceRuntime.ts. */
        var style = localStorage.getItem('typestyles-style') || '';
        if (!P.map[style]) {
          style = 'default';
        }

        var mode = localStorage.getItem('theme-mode');
        if (mode !== 'light' && mode !== 'dark' && mode !== 'system') mode = 'system';

        for (var i = 0; i < P.clear.length; i++) {
          var cls = P.clear[i];
          if (cls) rootEl.classList.remove(cls);
        }

        var nextClass = P.map[style] && P.map[style].className;
        if (nextClass) rootEl.classList.add(nextClass);
        rootEl.setAttribute('data-style', (P.map[style] && P.map[style].dataStyle) || style);
        if (mode === 'system') rootEl.removeAttribute('data-mode');
        else rootEl.setAttribute('data-mode', mode);
      } catch (e) {
        /* ignore invalid stored state or JSON */
      }
    }

    function applyToLiveDocument() {
      applyDocsAppearanceFromStorage(document.documentElement, document);
    }

    applyToLiveDocument();

    document.addEventListener('astro:before-swap', function (event) {
      applyDocsAppearanceFromStorage(event.newDocument.documentElement, event.newDocument);
    });

    document.addEventListener('astro:after-swap', applyToLiveDocument);
  })();
</script>
