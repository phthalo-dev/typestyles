---
import { Search } from '@lucide/astro';
import { siteHeader } from '../styles';
import type { AppearanceBootstrap } from '../lib/docsAppearanceRuntime';
import AppearanceControls from './AppearanceControls.astro';
import Logo from './Logo.astro';

type Props = {
  appearanceBootstrap: AppearanceBootstrap;
  /** Hide the mobile docs-sidebar toggle (e.g. playground has no sidebar). */
  hideMenuToggle?: boolean;
};

const { appearanceBootstrap, hideMenuToggle = false } = Astro.props;
---

<header class={siteHeader.root}>
  <div class={siteHeader.inner}>
    {
      !hideMenuToggle && (
        <button
          type="button"
          class={siteHeader.menuToggle}
          id="mobile-menu-toggle"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="docs-sidebar"
        >
          <span id="mobile-menu-icon" aria-hidden="true">☰</span>
        </button>
      )
    }
    <div class={siteHeader.left}>
      <Logo className={siteHeader.logo} accentClassName={siteHeader.logoAccent} />
      <nav class={siteHeader.nav} aria-label="Primary">
        <a href="/docs" class={siteHeader.navLink} data-site-header-docs-link>Docs</a>
        <a href="/playground" class={siteHeader.navLink} data-site-header-playground-link>
          Playground
        </a>
      </nav>
    </div>
    <div class={siteHeader.right}>
      <div class={siteHeader.searchWrapper} data-docs-search-field>
        <button
          type="button"
          class={siteHeader.searchTrigger}
          data-docs-search-trigger
          aria-label="Open search (Command+K)"
          aria-keyshortcuts="Meta+K Control+K"
        >
          <span class={siteHeader.searchIcon} aria-hidden="true">
            <Search size={16} stroke-width={2} />
          </span>
          <span class={siteHeader.searchTriggerLabel}>Search docs…</span>
          <span class={siteHeader.searchKbd} aria-hidden="true">⌘K</span>
        </button>
      </div>
      <AppearanceControls appearanceBootstrap={appearanceBootstrap} />
      <a
        href="https://github.com/phthalo-dev/typestyles"
        class={siteHeader.githubLink}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Typestyles on GitHub"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          class={siteHeader.githubIcon}
        >
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  function syncSiteHeaderNav(): void {
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    const docsLink = document.querySelector<HTMLAnchorElement>('[data-site-header-docs-link]');
    const playgroundLink = document.querySelector<HTMLAnchorElement>(
      '[data-site-header-playground-link]',
    );

    if (docsLink) {
      const onDocs = path === '/docs' || path.startsWith('/docs/');
      if (onDocs) docsLink.setAttribute('aria-current', 'page');
      else docsLink.removeAttribute('aria-current');
    }

    if (playgroundLink) {
      const onPlayground = path === '/playground' || path.startsWith('/playground/');
      if (onPlayground) playgroundLink.setAttribute('aria-current', 'page');
      else playgroundLink.removeAttribute('aria-current');
    }
  }

  document.addEventListener('astro:page-load', syncSiteHeaderNav);
  syncSiteHeaderNav();
</script>
