---
// @ts-nocheck
import { SegmentedControl, mergeProps } from '@var-ui/astro';
import { stage } from '@var-ui/core';
import { resolveLiveDemo } from '../lib/resolveLiveDemo';
import { highlightDocCode } from '../lib/highlightDocCode';
import { markdownCodeBlockHtml } from '../lib/markdownCodeBlockHtml';
import { liveDemo } from '../styles/liveDemo';

interface Props {
  id: string;
}

const { id } = Astro.props;
const { spec, code, usageCode, usageLang, usageLabel, cardClassName, previewCss, variants } =
  await resolveLiveDemo(id);
const defaultVariant = variants[0];
const bootstrap = JSON.stringify({ variants });
const domDisplay =
  spec.preview === 'themed-card'
    ? defaultVariant.themeClass
      ? `<div class="${defaultVariant.themeClass}">\n  <div class="${defaultVariant.className}">…</div>\n</div>`
      : `<div class="${defaultVariant.className}">…</div>`
    : `class="${defaultVariant.className}"`;

const defaultUsageCode = defaultVariant.usageCode ?? usageCode;
const defaultUsageLang = defaultVariant.usageLang ?? usageLang;

function panel(source: string, lang: string, filename?: string): string {
  const { safeLang, highlighted } = highlightDocCode(source, lang);
  return markdownCodeBlockHtml(safeLang, highlighted, filename);
}

const sourcePanel = panel(code, spec.codeLang, spec.headerLabel);
const usagePanel = defaultUsageCode
  ? panel(defaultUsageCode, defaultUsageLang, usageLabel || undefined)
  : null;
const domPanel = panel(domDisplay, 'xml', 'DOM');
const cssPanel = panel(defaultVariant.css, 'css', 'Emitted CSS');
const stageProps = mergeProps(stage({ fade: 'radial' }), liveDemo.preview);
const options = variants.map((v) => ({ value: v.id, label: v.label }));
---

<section
  class={liveDemo.root}
  data-live-demo={id}
  data-live-demo-preview={spec.preview}
  aria-label={spec.title}
>
  {previewCss && <style is:inline set:html={previewCss} data-live-demo-preview-css />}
  <script type="application/json" data-live-demo-data is:inline set:html={bootstrap}></script>

  <div class={liveDemo.header}>
    <div class={liveDemo.headerText}>
      <p class={liveDemo.title}>{spec.title}</p>
      <p class={liveDemo.caption}>
        Read-only live output. Choose a variant to see the preview, DOM classes, and emitted CSS
        update together.
      </p>
    </div>
    <SegmentedControl size="sm" options={options} aria-label="Demo variants" />
  </div>

  <div {...stageProps}>
    {
      spec.preview === 'button' ? (
        <button
          type="button"
          class:list={[liveDemo.previewButton, defaultVariant.className]}
          data-live-demo-preview
          data-live-demo-preview-base={liveDemo.previewButton}
        >
          Example button
        </button>
      ) : (
        <div data-live-demo-theme-wrap class={defaultVariant.themeClass ?? ''}>
          <div
            class:list={[liveDemo.previewCard, cardClassName]}
            data-live-demo-preview
            data-live-demo-preview-base={liveDemo.previewCard}
          >
            Themed surface
          </div>
        </div>
      )
    }
  </div>

  <div class={liveDemo.panels}>
    <div class={liveDemo.panel} set:html={sourcePanel} />
    {usagePanel && <div class={liveDemo.panel} data-live-demo-usage set:html={usagePanel} />}
    <div class={liveDemo.detailsGrid}>
      <div class={liveDemo.panel} data-live-demo-dom set:html={domPanel} />
      <div class={liveDemo.panel} data-live-demo-css set:html={cssPanel} />
    </div>
  </div>
</section>

<script>
  import { initLiveDemos } from '../scripts/liveDemoClient';
  initLiveDemos();
  document.addEventListener('astro:page-load', initLiveDemos);
</script>
