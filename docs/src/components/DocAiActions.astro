---
// @ts-nocheck
import { Button, Menu } from '@var-ui/astro';
import { docAiActions } from '../styles/docAiActions';

type Props = {
  markdownUrl: string;
};

const { markdownUrl } = Astro.props;
const prompt = encodeURIComponent(`Read ${markdownUrl} so we can discuss it`);
const claudeUrl = `https://claude.ai/new?q=${prompt}`;
const chatGptUrl = `https://chatgpt.com/?q=${prompt}`;
---

<div class={docAiActions.root} data-doc-ai-actions data-md-url={markdownUrl}>
  <Button size="sm" tone="neutral" appearance="outline" data-doc-copy-md>Copy as Markdown</Button>
  <Button size="sm" tone="neutral" appearance="outline" href={markdownUrl}>View as Markdown</Button>
  <Menu
    triggerLabel="Open in AI"
    menuLabel="Open this page in an AI assistant"
    size="sm"
    tone="neutral"
    appearance="outline"
    placement="bottom start"
    sections={[
      {
        items: [
          { id: 'open-claude', label: 'Open in Claude', href: claudeUrl },
          { id: 'open-chatgpt', label: 'Open in ChatGPT', href: chatGptUrl },
        ],
      },
    ]}
  />
</div>

<script>
  import { attachDocAiActions } from '../scripts/docAiActions';
  attachDocAiActions();
</script>
