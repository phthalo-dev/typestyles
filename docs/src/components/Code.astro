---
/**
 * Code block for Astro pages: pass source as `code` + optional `lang`. Same markup as fenced
 * markdown blocks (the kit's `codeBlock` recipe via `markdownCodeBlockHtml`), so it shares their
 * styling and the delegated copy handler (`attachDocsCodeBlockCopyListeners`, bundled once per page).
 */
import { highlightDocCode } from '../lib/highlightDocCode';
import { markdownCodeBlockHtml } from '../lib/markdownCodeBlockHtml';

interface Props {
  code: string;
  lang?: string;
  /** Header label (e.g. filename), shown before the language. */
  headerLabel?: string;
}

const { code, lang, headerLabel } = Astro.props;
const { safeLang, highlighted } = highlightDocCode(code, lang);
const html = markdownCodeBlockHtml(safeLang, highlighted, headerLabel?.trim() || undefined);
---

<Fragment set:html={html} />

<script>
  import { attachDocsCodeBlockCopyListeners } from '../scripts/docsCodeBlockCopy';
  attachDocsCodeBlockCopyListeners();
</script>
