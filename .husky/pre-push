branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$branch" = "main" ]; then
  exit 0
fi

changed_files=$(git diff --name-only origin/main...HEAD 2>/dev/null || true)

# Root tooling and CI do not publish a package. A workspace package.json
# (packages/*/package.json) still needs a changeset.
if [ -n "$changed_files" ] && [ -z "$(echo "$changed_files" | grep -Ev '^(\.github/|\.husky/|\.changeset/|\.vscode/|\.npmrc|AGENTS\.md|README\.md|specs/|scripts/|package\.json$)' || true)" ]; then
  exit 0
fi

changesets=$(git diff --name-only origin/main...HEAD -- '.changeset/*.md' 2>/dev/null | grep -v 'README.md' || true)

if [ -z "$changesets" ]; then
  echo "❌ No changeset found for this branch."
  echo "   Please run 'pnpm changeset' to create one before pushing."
  exit 1
fi
