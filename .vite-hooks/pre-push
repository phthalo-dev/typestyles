# CI runs the changesets release, which commits and pushes; hooks are for local work.
if [ -n "$CI" ]; then
  exit 0
fi

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$branch" = "main" ]; then
  exit 0
fi

changed_files=$(git diff --name-only origin/main...HEAD 2>/dev/null || true)

if [ -n "$changed_files" ] && [ -z "$(echo "$changed_files" | grep -Ev '^(\.github/|\.vite-hooks/|\.changeset/|\.vscode/|\.npmrc|\.nvmrc|netlify\.toml|AGENTS\.md|README\.md|specs/|scripts/|package\.json$|vite\.config\.ts$|pnpm-workspace\.yaml$)' || true)" ]; then
  exit 0
fi

changesets=$(git diff --name-only origin/main...HEAD -- '.changeset/*.md' 2>/dev/null | grep -v 'README.md' || true)

if [ -z "$changesets" ]; then
  echo "❌ No changeset found for this branch."
  echo "   Please run 'pnpm changeset' to create one before pushing."
  exit 1
fi

# Same command CI runs. `vp install` is skipped: dependencies are already installed locally.
vp run ci
