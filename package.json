{
  "name": "typestyles-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "vp run -F \"./packages/*\" build",
    "test": "vp run -r test",
    "dev": "vp run -r dev",
    "build-runner": "pnpm --filter @typestyles/build-runner",
    "typestyles": "pnpm --filter typestyles",
    "props": "pnpm --filter @typestyles/props",
    "open-props": "pnpm --filter @typestyles/open-props",
    "vite": "pnpm --filter @typestyles/vite",
    "astro": "pnpm --filter @typestyles/astro",
    "rollup": "pnpm --filter @typestyles/rollup",
    "esbuild": "pnpm --filter @typestyles/esbuild",
    "webpack": "pnpm --filter @typestyles/webpack",
    "next": "pnpm --filter @typestyles/next",
    "react": "pnpm --filter @typestyles/react",
    "migrate": "pnpm --filter @typestyles/migrate",
    "eslint-plugin": "pnpm --filter @typestyles/eslint-plugin",
    "vite-app": "pnpm --filter typestyles-vite-example",
    "rollup-app": "pnpm --filter typestyles-rollup-example",
    "rolldown-app": "pnpm --filter typestyles-rolldown-example",
    "esbuild-app": "pnpm --filter typestyles-esbuild-example",
    "parcel-app": "pnpm --filter typestyles-parcel-example",
    "vue-app": "pnpm --filter typestyles-vue-example",
    "svelte-app": "pnpm --filter typestyles-svelte-example",
    "next-app": "pnpm --filter @examples/next",
    "design-system": "pnpm --filter @examples/design-system",
    "react-design-system": "pnpm --filter @examples/react-design-system",
    "typewind": "pnpm --filter @examples/typewind",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "verify": "vp run ci",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "changeset": "changeset",
    "version": "changeset version",
    "version:unstable": "node scripts/set-unstable-versions.js",
    "release": "vp run build && changeset publish",
    "prepare": "vp config",
    "check": "vp check",
    "fmt": "vp fmt"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.29.8",
    "@typestyles/eslint-plugin": "workspace:*",
    "vite-plus": "catalog:"
  }
}
